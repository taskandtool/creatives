# Never commit credentials or local state. Task & Tool delivers env to a
# machine at install time; nothing in this repo should ever hold a key.
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# Working material and rendered output are the owner's, made on their own
# machine. The folders and the notes that explain them ship with the app;
# nobody's creatives do.
creatives/generated/*
creatives/approved/*
creatives/scheduled/*
creatives/posted/*
creatives/rejected/*
campaigns/*/
inbox/decisions/*
media/clips/*
media/logo/*
media/photos/*
raw/*
swipe/*
uploads/*
*.raw.png
render.html
!**/.gitkeep
!**/README.md
!**/_notes.md

# Tool noise
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
